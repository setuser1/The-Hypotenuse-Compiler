#include <stddef.h>

space streams {
    asm int sys_read(int fd, string buf, int count) {
        syntax arm64_macho
        .section __TEXT,__text
        mov x16, #3
        svc #0x80
        ret
    }

    asm int sys_write(int fd, string buf, int count) {
        syntax arm64_macho
        .section __TEXT,__text
        mov x16, #4
        svc #0x80
        ret
    }

    asm int sys_open(string path, int flags, int mode) {
        syntax arm64_macho
        .section __TEXT,__text
        mov x16, #5
        svc #0x80
        ret
    }

    asm int sys_close(int fd) {
        syntax arm64_macho
        .section __TEXT,__text
        mov x16, #6
        svc #0x80
        ret
    }

    asm int sys_unlink(string path) {
        syntax arm64_macho
        .section __TEXT,__text
        mov x16, #10
        svc #0x80
        ret
    }

    string read_file(int fd) {
        dynam char buffer = [];
        char tmp[256];
        int n;
        while ((n = sys_read@streams(fd, tmp, 256)) > 0) {
            int i = 0;
            while (i < n) { buffer.push(tmp[i]); i = i + 1; }
        }
        if (n < 0) { return NULL; }
        buffer.push('\0');
        return buffer;
    }

    int open_file(string path) {
        return sys_open@streams(path, 0, 0);
    }

    string write_file(string s, int fd) {
        if (s) { sys_write@streams(fd, s, len(s)); }
        return s;
    }

    void close_file(int fd) {
        sys_close@streams(fd);
    }

    int exists(string path) {
        int fd = open_file@streams(path);
        if (fd < 0) { return 0; }
        close_file@streams(fd);
        return 1;
    }

    string remove_file(string path) {
        if (exists(path)) {
            sys_unlink(path);
            return path;
        }
        return NULL;
    }
}

string outstream(string buffer, string path) {
    int fd = open_file@streams(path);
    if (fd < 0 || !exists@streams(path)) { return NULL; }
    string result = write_file@streams(buffer, fd);
    close_file@streams(fd);
    return result;
}

string instream(string path) {
    int fd = open_file@streams(path);
    if (fd < 0 || !exists@streams(path)) { 
        return "stderr: failed to read file";
        exit(1);
    }
    string result = read_file@streams(fd);
    close_file@streams(fd);
    return result;
}

int sizeget(string path) {
    string stream = instream(path);
    if (!stream) { return -1; }
    return len(stream);
}

string steal(string path, string out_path) {
    string stream = instream(path);
    if (!stream) { return NULL; }
    if (!outstream(stream, out_path)) { return NULL; }
    return stream;
}

void remove(string path) {
    remove_file@streams(path);
}
