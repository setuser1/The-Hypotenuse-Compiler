#include <stdarg.h>

space printd {

asm int sys_write(int fd, string buf, int count) {
    syntax arm64_macho
    .section __TEXT,__text
    mov x16, #4
    svc #0x80
    ret
}

void print_c(char c) { sys_write(1, &c, 1); }

void print_s(string s) {
    if (s) { sys_write(1, s, len(s)); }
}

void print_num(unsigned long n, int base, int upper) {
    if (n == 0) { print_c('0'); return; }
    dynam char digits = [];
    while (n) {
        int d = n % base;
        char c = d < 10 ? '0' + d : (upper ? 'A' + d - 10 : 'a' + d - 10);
        digits.push(c);
        n = n / base;
    }
    while (digits.len() > 0) {
        print_c(digits.pop());
    }
}

void print_d(int n) {
    if (n < 0) { print_c('-'); n = -n; }
    print_num(n, 10, 0);
}

void print_ld(long n) {
    if (n < 0) { print_c('-'); n = -n; }
    print_num(n, 10, 0);
}

void print_lld(long long n) {
    if (n < 0) { print_c('-'); n = -n; }
    print_num(n, 10, 0);
}

void print_f(double f) {
    if (f < 0) { print_c('-'); f = -f; }
    long ip = (long)f;
    print_num(ip, 10, 0);
    print_c('.');
    for (int i = 0; i < 6; i++) {
        f = f * 10;
        print_c('0' + (int)f);
        f = f - (int)f;
    }
}
}

void printd(string fmt, ...) {
    int pos = 0;
    int n = len(fmt);
    va_list a;
    va_start(a, fmt);
    while (pos < n) {
        char c = fmt[pos];
        if (c == '%') {
            pos = pos + 1;
            c = fmt[pos];
            if (c == 'l') {
                char c2 = fmt[pos + 1];
                if (c2 == 'l' && fmt[pos + 2] == 'd') { print_lld@printd(va_arg(a, long long)); pos = pos + 2; }
                else if (c2 == 'd') { print_ld@printd(va_arg(a, long)); pos = pos + 1; }
                else if (c2 == 'u') { print_num@printd(va_arg(a, unsigned long), 10, 0); pos = pos + 1; }
            } else if (c == 'd' || c == 'i') { print_d@printd(va_arg(a, int)); }
            else if (c == 'u') { print_num@printd(va_arg(a, unsigned int), 10, 0); }
            else if (c == 'o') { print_num@printd(va_arg(a, unsigned int), 8, 0); }
            else if (c == 'x') { print_num@printd(va_arg(a, unsigned int), 16, 0); }
            else if (c == 'X') { print_num@printd(va_arg(a, unsigned int), 16, 1); }
            else if (c == 'p') { print_num@printd((unsigned long)va_arg(a, void*), 16, 0); }
            else if (c == 's') { print_s@printd(va_arg(a, char*)); }
            else if (c == 'c') { print_c@printd((char)va_arg(a, int)); }
            else if (c == 'f') { print_f@printd(va_arg(a, double)); }
            else if (c == '%') { print_c@printd('%'); }
        } else { print_c@printd(c); }
        pos = pos + 1;
    }
    va_end(a);
    print_c@printd('\n');
}
