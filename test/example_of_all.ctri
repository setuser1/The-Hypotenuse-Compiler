// C triangle syntax example file demonstrating ALL features
/*
  HIIIII
*/


using <printd>

// struct with constructors and member function
struct Example(int value) {
    init {
      self.value = value;
    }
    end {}
    // display: prints the provided value
    void display(int value) {
        printd(value);
    }
}

struct Inheritor {
    init {
        self.name = "Default";
    }
    end {}
    string name;
}



void function_example(tuple loop) {
    // iterate over a tuple-like collection and print each element
    for(int i = 0; i < len(loop); i++) {
        printd(i);
    }
}

void vars() {
    // sample variable declarations of different types
    int a = 10;
    float b = 20.5;
    string c = "Hello";
}

int main() {
  
    Example structure = Example(1);
    structure.display(structure.value);
  
    // inline assembly block demonstrating a simple write and exit syscall on x86_64
    asm {
        syntax x86_64_linux
        
        section .data
        string msg = "Hello, World!\n"
        
        section .text
        mov rax, 1
        mov rdi, 1
        lea rsi, [msg]
        mov rdx, 14
        syscall

        mov rax, 60
        xor rdi, rdi
        syscall
    }
    
    // call example: bring local vars into scope (language-specific "using" syntax)
    using vars&a;
    int y = a + 5;

    // dynamic array handling example with allocation and free
    dynam int arr = [1, 2, 3, 4, 5]; 

    return 0;
}
