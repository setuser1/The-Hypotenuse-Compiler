// C△ Control Flow Test Suite
// Tests all control structures: if/else, while, for, switch/case, break, continue

#include <stdio.h>

// ============================================================
// Test 1: if/else statements
// ============================================================

void test_if_else(void) {
    int x = 10;
    int y = 20;
    
    // Simple if
    if (x > 0) {
        printf("x is positive\n");
    }
    
    // if-else
    if (x > y) {
        printf("x > y\n");
    } else {
        printf("x <= y\n");
    }
    
    // if-else if-else
    if (x > 20) {
        printf("x > 20\n");
    } else if (x > 15) {
        printf("x > 15\n");
    } else if (x > 5) {
        printf("x > 5\n");
    } else {
        printf("x <= 5\n");
    }
    
    // Nested if without braces (single statement)
    if (x == 10)
        if (y == 20)
            printf("nested if without braces\n");
}

// ============================================================
// Test 2: while loops
// ============================================================

void test_while(void) {
    int i = 0;
    
    // Basic while loop
    while (i < 5) {
        printf("while: %d\n", i);
        i++;
    }
    
    // While with break
    i = 0;
    while (1) {
        if (i >= 3) {
            break;
        }
        printf("while with break: %d\n", i);
        i++;
    }
    
    // While with continue
    i = 0;
    while (i < 5) {
        i++;
        if (i == 2) {
            continue;
        }
        printf("while with continue: %d\n", i);
    }
}

// ============================================================
// Test 3: for loops
// ============================================================

void test_for(void) {
    // Basic for loop
    for (int i = 0; i < 3; i++) {
        printf("for: %d\n", i);
    }
    
    // For loop with multiple variables
    for (int i = 0, j = 10; i < 3 && j > 7; i++, j--) {
        printf("for multi: i=%d, j=%d\n", i, j);
    }
    
    // For loop with break
    for (int i = 0; i < 10; i++) {
        if (i == 5) {
            break;
        }
        printf("for with break: %d\n", i);
    }
    
    // For loop with continue
    for (int i = 0; i < 5; i++) {
        if (i == 2) {
            continue;
        }
        printf("for with continue: %d\n", i);
    }
    
    // Nested for loops
    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 2; j++) {
            printf("nested for: i=%d, j=%d\n", i, j);
        }
    }
}

// ============================================================
// Test 4: do-while loops
// ============================================================

void test_do_while(void) {
    int i = 0;
    
    // Basic do-while
    do {
        printf("do-while: %d\n", i);
        i++;
    } while (i < 3);
    
    // Do-while with break
    i = 0;
    do {
        if (i == 2) {
            break;
        }
        printf("do-while with break: %d\n", i);
        i++;
    } while (i < 5);
}

// ============================================================
// Test 5: switch/case statements
// ============================================================

void test_switch(int val) {
    // Basic switch with break
    switch (val) {
        case 1:
            printf("case 1\n");
            break;
        case 2:
            printf("case 2\n");
            break;
        case 3:
            printf("case 3\n");
            break;
        default:
            printf("default case\n");
            break;
    }
    
    // Switch without breaks (fall-through)
    switch (val) {
        case 1:
        case 2:
        case 3:
            printf("case 1, 2, or 3\n");
            break;
        default:
            printf("other\n");
    }
}

// ============================================================
// Test 6: Nested control structures
// ============================================================

void test_nested(void) {
    // Nested if inside for
    for (int i = 0; i < 3; i++) {
        if (i == 1) {
            printf("i is 1\n");
        } else {
            printf("i is not 1\n");
        }
    }
    
    // Nested loops with if
    int count = 0;
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            if (i == j) {
                continue;
            }
            if (i + j > 3) {
                break;
            }
            count++;
        }
    }
    printf("nested count: %d\n", count);
    
    // Deep nesting
    if (1) {
        if (1) {
            if (1) {
                printf("deeply nested\n");
            }
        }
    }
    
    // Switch inside loop
    for (int i = 1; i <= 3; i++) {
        switch (i) {
            case 1:
                printf("loop case 1\n");
                break;
            case 2:
                printf("loop case 2\n");
                break;
            default:
                printf("loop default\n");
        }
    }
    
    // While inside if
    if (1) {
        int k = 0;
        while (k < 2) {
            printf("while in if: %d\n", k);
            k++;
        }
    }
}

// ============================================================
// Test 7: Complex conditions
// ============================================================

void test_complex_conditions(void) {
    int a = 5;
    int b = 10;
    int c = 15;
    
    // Complex logical conditions
    if (a > 0 && b > 0 && c > 0) {
        printf("all positive\n");
    }
    
    if (a > 10 || b > 10 || c > 10) {
        printf("at least one > 10\n");
    }
    
    // Nested logical conditions
    if ((a > 0 && b > 0) || (c > 20)) {
        printf("complex condition met\n");
    }
    
    // In loop
    for (int i = 0; i < 10 && i != 5; i++) {
        printf("complex for: %d\n", i);
    }
}

// ============================================================
// Test 8: goto and labels
// ============================================================

void test_goto(void) {
    int i = 0;
    
start:
    printf("goto: %d\n", i);
    i++;
    if (i < 3) {
        goto start;
    }
    
end_label:
    printf("goto end\n");
}

// ============================================================
// Main function
// ============================================================

int main(void) {
    printf("=== Testing Control Flow ===\n\n");
    
    printf("--- if/else ---\n");
    test_if_else();
    
    printf("\n--- while ---\n");
    test_while();
    
    printf("\n--- for ---\n");
    test_for();
    
    printf("\n--- do-while ---\n");
    test_do_while();
    
    printf("\n--- switch/case ---\n");
    test_switch(2);
    test_switch(5);
    
    printf("\n--- nested ---\n");
    test_nested();
    
    printf("\n--- complex conditions ---\n");
    test_complex_conditions();
    
    printf("\n--- goto ---\n");
    test_goto();
    
    printf("\n=== All tests completed ===\n");
    return 0;
}
