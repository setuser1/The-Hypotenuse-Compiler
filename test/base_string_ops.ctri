int main() {
    string greeting = "hello";
    string suffix = " world";
    greeting = "hi";
    greeting = greeting + suffix;

    int greeting_len = len(greeting);
    int is_hi = greeting == "hi world";
    int is_not_empty = greeting != "";
    int same_suffix = suffix == " world";

    return greeting_len + is_hi + is_not_empty + same_suffix;
}
