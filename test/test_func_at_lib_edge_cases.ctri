using "../plstd/string"

int test_edge_cases() {
    string s = "test";
    
    // Test func@lib without arguments
    int len = strlen@string(s);
    
    // Test multiple @ signs (should fail)
    // int bad = strlen@string@other(s); // This should cause an error
    
    // Test @ at start (should fail)
    // int bad2 = @string_strlen(s); // This should cause an error
    
    return len;
}
