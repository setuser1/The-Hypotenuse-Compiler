// Test file for arithmetic operations and expressions
// Tests basic operators, literals, variables, and complex expressions

#include <stdio.h>

// Test basic arithmetic operations
void test_basic_arithmetic() {
    // Basic operations: +, -, *, /, %
    int a = 10 + 5;
    int b = 20 - 8;
    int c = 7 * 6;
    int d = 100 / 4;
    int e = 17 % 5;
    
    printf("Basic: %d %d %d %d %d\n", a, b, c, d, e);
}

// Test integer literals (positive and negative)
void test_literals() {
    int pos = 42;
    int neg = -15;
    int zero = 0;
    int large = 1000000;
    int hex = 0xFF;
    int octal = 0777;
    
    printf("Literals: %d %d %d %d %d %d\n", pos, neg, zero, large, hex, octal);
}

// Test variable assignments
void test_assignments() {
    int x = 100;
    int y;
    y = 50;
    int z = x + y;
    
    // Compound assignments
    int a = 10;
    a += 5;
    a -= 3;
    a *= 2;
    a /= 4;
    a %= 3;
    
    printf("Assignments: %d %d %d\n", x, y, z);
    printf("After compound: %d\n", a);
}

// Test complex expressions with parentheses
void test_complex_expressions() {
    // Order of operations
    int result1 = 2 + 3 * 4;
    int result2 = (2 + 3) * 4;
    int result3 = 10 - 5 + 2;
    int result4 = 10 - (5 + 2);
    
    // Nested parentheses
    int result5 = ((1 + 2) * (3 + 4)) / 7;
    int result6 = 100 / (5 * (2 + 3));
    
    // Multiple operators
    int result7 = 1 + 2 + 3 + 4 + 5;
    int result8 = 10 * 9 * 8 / 4 / 2;
    
    printf("Complex: %d %d %d %d %d %d %d %d\n", 
           result1, result2, result3, result4, 
           result5, result6, result7, result8);
}

// Test mixed type operations
void test_mixed_types() {
    int i = 10;
    float f = 3.5;
    double d = 2.718;
    
    // Mixed operations
    float result1 = i + f;
    double result2 = i * d;
    float result3 = f / 2;
    double result4 = (double)i / 3;
    
    printf("Mixed: %.1f %.3f %.1f %.3f\n", result1, result2, result3, result4);
}

// Test unary operations
void test_unary() {
    int x = 10;
    int y = -x;
    int z = +x;
    int w = !x;
    int v = ~x;
    
    // Pre/post increment/decrement
    int a = 5;
    int b = ++a;
    int c = a++;
    int d = --a;
    int e = a--;
    
    printf("Unary: %d %d %d %d %d\n", x, y, z, w, v);
    printf("Inc/Dec: %d %d %d %d %d\n", a, b, c, d, e);
}

// Test modulo operations
void test_modulo() {
    int a = 17 % 5;
    int b = -17 % 5;
    int c = 17 % -5;
    int d = 100 % 7;
    int e = 7 % 7;
    int f = 1 % 7;
    
    printf("Modulo: %d %d %d %d %d %d\n", a, b, c, d, e, f);
}

// Test expressions in control structures
void test_expressions_in_control() {
    int x = 5;
    int y = 10;
    
    if (x + y > 10) {
        printf("Sum is greater than 10\n");
    }
    
    for (int i = 0; i < x * 2; i++) {
        printf("%d ", i);
    }
    printf("\n");
    
    int count = 0;
    while (count < (x + y) / 2) {
        count++;
    }
    printf("Count: %d\n", count);
}

// Test division edge cases
void test_division() {
    int a = 7 / 3;
    int b = 7 / -3;
    int c = -7 / 3;
    int d = -7 / -3;
    float e = 7.0 / 3.0;
    
    printf("Division: %d %d %d %d %.2f\n", a, b, c, d, e);
}

// Main function
int main() {
    printf("=== Arithmetic Test Suite ===\n");
    
    test_basic_arithmetic();
    test_literals();
    test_assignments();
    test_complex_expressions();
    test_mixed_types();
    test_unary();
    test_modulo();
    test_expressions_in_control();
    test_division();
    
    printf("=== All tests completed ===\n");
    return 0;
}
