#include <stdio.h>

/* Function Test Suite for Hypotenuse Compiler
 * Testing function declarations, definitions, and recursion
 */

/* 1. SIMPLE FUNCTION DEFINITIONS */
int simple_no_params() {
    return 42;
}

char simple_char_return() {
    return 'A';
}

/* 2. FUNCTIONS WITH PARAMETERS (various types) */
int add(int a, int b) {
    return a + b;
}

float multiply(float x, float y) {
    return x * y;
}

double divide(double a, double b) {
    return a / b;
}

/* 3. FUNCTIONS WITH MULTIPLE PARAMETERS OF DIFFERENT TYPES */
float calculate(int a, float b, double c) {
    return a + b + (float)c;
}

/* 4. RECURSIVE FUNCTIONS */

// Factorial: n! = n * (n-1)!
int factorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

// Fibonacci: F(n) = F(n-1) + F(n-2)
int fibonacci(int n) {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

// Fibonacci with memoization (using global)
int fib_memo[50];

int fibonacci_memo(int n) {
    if (n <= 1) {
        return n;
    }
    if (fib_memo[n] != 0) {
        return fib_memo[n];
    }
    fib_memo[n] = fibonacci_memo(n - 1) + fibonacci_memo(n - 2);
    return fib_memo[n];
}

// Power function: x^n using recursion
float power(float x, int n) {
    if (n == 0) {
        return 1.0;
    }
    if (n < 0) {
        return 1.0 / power(x, -n);
    }
    return x * power(x, n - 1);
}

/* 5. FUNCTION PROTOTYPES */
int prototype_func(int a, int b);
char char_prototype(void);
void void_prototype(int x);

/* 6. VOID FUNCTIONS */
void print_hello() {
    printf("Hello from void function\n");
}

void print_number(int n) {
    printf("Number: %d\n", n);
}

void modify_value(int* ptr) {
    if (ptr != NULL) {
        *ptr = 100;
    }
}

void swap(int* a, int* b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

/* MAIN FUNCTION - Entry Point */
int main() {
    int result;
    float f_result;
    
    /* Test simple functions */
    result = simple_no_params();
    printf("simple_no_params: %d\n", result);
    
    /* Test functions with parameters */
    result = add(10, 20);
    printf("add(10, 20): %d\n", result);
    
    f_result = multiply(3.5, 2.0);
    printf("multiply(3.5, 2.0): %f\n", f_result);
    
    /* Test recursive functions */
    result = factorial(5);
    printf("factorial(5): %d\n", result);
    
    result = fibonacci(10);
    printf("fibonacci(10): %d\n", result);
    
    f_result = power(2.0, 8);
    printf("power(2.0, 8): %f\n", f_result);
    
    /* Test void functions */
    print_hello();
    print_number(42);
    
    return 0;
}

/* Definition of prototype functions */
int prototype_func(int a, int b) {
    return a * b;
}

char char_prototype(void) {
    return 'Z';
}

void void_prototype(int x) {
    printf("void_prototype called with: %d\n", x);
}
