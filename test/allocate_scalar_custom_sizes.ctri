int main() {
    allocate char letter(1) = 'A';
    allocate short small_short(1) = 127;
    allocate unsigned byte_value(1) = 255;
    allocate float ratio(4) = 1.5;
    allocate double precise(8) = 2.25;
    free(letter);
    free(small_short);
    free(byte_value);
    free(ratio);
    free(precise);
    return 0;
}
