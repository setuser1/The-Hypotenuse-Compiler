// Simple C11 Test - Typedef in struct
#include <stdio.h>

// Test typedef
typedef unsigned int mytype_t;

// Test struct with typedef member  
struct Test {
    int x;
    mytype_t y;
};

// Test array parameter
void func(char *argv[]);

// Test struct return
struct Test make_test(int a, int b);

// Test storage specifiers
static int counter = 0;
extern int errno;

// Test adjacent strings
char* msg = "hello " "world";

// Test hex suffix
unsigned long long val = 0xABCULL;

int main(void) {
    return 0;
}
