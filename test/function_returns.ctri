#include <stdio.h>
// Test file for function return values
// Covers: variable returns, binary expressions, function calls, mixed expressions


int getFive() { return 5; }
int add(int a, int b) { return a + b; }
int getAnswer() { return 42; }

// Test 1: Variable return - return x
int testVarReturn() {
    int x = 10;
    return x;
}

// Test 2: Binary expression return - return a + b
int testAddExpr() {
    int a = 3;
    int b = 4;
    return a + b;
}

// Test 3: Binary expression return - return x * y
int testMulExpr() {
    int x = 5;
    int y = 6;
    return x * y;
}

// Test 4: Function call return - return getFive()
int testFuncCallNoArgs() {
    return getFive();
}

// Test 5: Function call return - return add(3, 4)
int testFuncCallWithArgs() {
    return add(3, 4);
}

// Test 6: Mixed expression - return x + getAnswer()
int testMixedExpr() {
    int x = 1;
    return x + getAnswer();
}

// Test 7: Mixed expression - return getAnswer() + y
int testMixedExpr2() {
    int y = 5;
    return getAnswer() + y;
}

// Test 8: Nested function calls - return add(getFive(), getAnswer())
int testNestedCalls() {
    return add(getFive(), getAnswer());
}

int main() {
    int r1 = testVarReturn();
    printf("%d", r1);
    
    int r2 = testAddExpr();
    printf("%d", r2);
    
    int r3 = testMulExpr();
    printf("%d", r3);
    
    int r4 = testFuncCallNoArgs();
    printf("%d", r4);
    
    int r5 = testFuncCallWithArgs();
    printf("%d", r5);
    
    int r6 = testMixedExpr();
    printf("%d", r6);
    
    int r7 = testMixedExpr2();
    printf("%d", r7);
    
    int r8 = testNestedCalls();
    printf("%d", r8);
    
    return 0;
}